{
  "name": "thangkagrid",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric vector engine, declarative JSON schema, and interactive CAD visualizer for sacred Himalayan iconometry (Tibetan Thangka and Newari Paubha Thigse grids).",
  "license": "MIT",
  "author": "Ashok Adhikari",
  "repository": {
    "type": "git",
    "url": "https://github.com/adhikari18/ThangkaGrid.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=@thangkagrid/visualizer",
    "cli": "node packages/cli/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
